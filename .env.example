# Supabase (проект Family Vault)
# URL и публичный (publishable/anon) ключ — безопасны для клиента.
NEXT_PUBLIC_SUPABASE_URL=https://uuopxzlcmzdtwebottar.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Service role — СЕКРЕТ, только на сервере. Нужен странице /s/[token],
# чтобы выдавать короткие signed URL анонимному получателю share-ссылки.
# Возьми в Supabase Dashboard → Project Settings → API → service_role.
# НЕ коммить реальное значение.
SUPABASE_SERVICE_ROLE_KEY=

# AI-распознавание документов (doc-classify). Необязательно.
# Роут /api/classify сам выбирает провайдера: если задан GLM_API_KEY — GLM (z.ai),
# иначе если задан ANTHROPIC_API_KEY — Claude. Если нет ни одного — фича отключается.
# Ключ Anthropic: https://console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Ключ GLM (z.ai): https://z.ai → API. Дешевле, но данные уходят в КНР.
GLM_API_KEY=
GLM_MODEL=glm-4.6
GLM_VISION_MODEL=glm-4v
# Дневной лимит ИИ-запросов на пользователя (doc-classify и AI-черновик вакансии).
AI_DAILY_LIMIT=50

# T11 Vacancy Composer, Layer 2 (AI-freeform «Помочь составить вакансию»).
# Env-гейт: значение "off" полностью выключает AI-черновик, не трогая
# ручной путь и шаблоны. По умолчанию (пусто/любое др. значение) — включено.
# Сам вызов модели использует GLM_API_KEY/GLM_MODEL выше; без ключа роут
# отвечает «недоступно», а шаблоны и ручное создание работают как обычно.
VACANCY_AI_COMPOSER=

# Напоминания о сроках (ежедневный крон + письма) и алерты входа.
# Resend: https://resend.com → API Keys. Без него письма не отправляются.
RESEND_API_KEY=
ALERT_EMAIL_FROM=Семейный сейф <noreply@doki.help>
# Секрет для защиты крона /api/cron/reminders (Vercel шлёт его в Authorization).
# Сгенерируй любую длинную случайную строку и задай тем же значением в Vercel.
CRON_SECRET=
# Публичный адрес приложения (для ссылок в письмах).
NEXT_PUBLIC_APP_URL=https://doki.help

# ── iOS App Store обёртка (Capacitor). См. docs/app-store/. ───────────
# URL, который грузит нативный WebView. Пусто → https://www.doki.help.
# Для локальной отладки: http://<LAN-IP>:3000 (нужно временное ATS-исключение).
CAP_SERVER_URL=
# APNs (push из крона напоминаний на нативные устройства). Ключ .p8 создаётся в
# Apple Developer → Keys. Приём токенов уже работает (/api/native/push-token),
# отправку подключить в app/api/cron/reminders (см. docs/app-store/RUNBOOK.md §5).
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=help.doki.app
APNS_PRIVATE_KEY=
APNS_PRODUCTION=true
